post_install() {
    # Apply the keypad udev rule without a reboot.
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=hidraw --subsystem-match=usb 2>/dev/null || true
    echo "OpenKeyForge: replug your keypad if it was already connected."
}

post_upgrade() {
    post_install
}
